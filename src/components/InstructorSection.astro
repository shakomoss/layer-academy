---
import { render, type CollectionEntry } from 'astro:content';
import InstructorFactTags from './InstructorFactTags.astro';

interface Props {
  instructor: CollectionEntry<'instructors'>;
}

const { instructor } = Astro.props;
const { name, title, facts } = instructor.data;
const { Content } = await render(instructor);
---
<section class="instructor-section">
  <h2>ვინ გასწავლით</h2>
  <p class="instructor-name">{name}</p>
  <p class="instructor-title">{title}</p>
  <InstructorFactTags facts={facts} />
  <div class="instructor-body">
    <Content />
  </div>
</section>

<style>
  .instructor-section {
    margin-block: var(--space-5);
  }

  .instructor-section h2 {
    font-size: 24px;
    font-weight: 600;
  }

  .instructor-name {
    margin-top: var(--space-2);
    font-size: 18px;
    font-weight: 600;
  }

  .instructor-title {
    margin-top: 0.2rem;
    font-size: 15px;
    color: var(--color-muted);
  }

  .instructor-section :global(.fact-tags) {
    margin-top: var(--space-2);
  }

  .instructor-body {
    margin-top: var(--space-3);
  }

  .instructor-body :global(p) {
    margin-top: var(--space-2);
  }

  .instructor-body :global(p:first-child) {
    margin-top: 0;
  }
</style>
