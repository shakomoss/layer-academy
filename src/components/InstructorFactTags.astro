---
interface Props {
  facts: string[];
}

const { facts } = Astro.props;
---
<ul class="fact-tags">
  {facts.map((fact) => (
    <li>{fact}</li>
  ))}
</ul>

<style>
  .fact-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fact-tags li {
    font-size: 14px;
    border: 1px solid var(--color-divider);
    padding: 4px 10px;
  }
</style>
