---
import CohortLabelInline from './CohortLabel.astro';

interface Props {
  nextStartDate?: Date;
  schedule?: string;
  duration?: string;
}

const { nextStartDate, schedule, duration } = Astro.props;
---
<div class="key-facts">
  <ul class="key-facts-list">
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3.5" y="4.5" width="17" height="16" rx="1" />
        <path d="M3.5 9h17M8 3v3M16 3v3" />
      </svg>
      <CohortLabelInline nextStartDate={nextStartDate} />
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="4.5" width="18" height="12" rx="1" />
        <path d="M8.5 20h7M12 16.5V20" />
      </svg>
      <span>ონლაინ, ლაივ ლექციები</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </svg>
      <span>{schedule || 'განრიგი მალე დაზუსტდება'}</span>
    </li>
    {duration && (
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
        <span>{duration}</span>
      </li>
    )}
  </ul>
</div>

<style>
  .key-facts-list {
    list-style: none;
    margin: 0;
    padding: var(--space-3) 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
  }

  .key-facts-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .key-facts-list svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-muted);
  }
</style>
