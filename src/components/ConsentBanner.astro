---
interface Props {
  pixelId: string;
  ga4Id: string;
  clarityId: string;
  messengerPageId: string;
}

const { pixelId, ga4Id, clarityId, messengerPageId } = Astro.props;
---
<div
  id="consent-banner"
  class="consent-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie-ების თანხმობა"
  data-pixel-id={pixelId}
  data-ga4-id={ga4Id}
  data-clarity-id={clarityId}
  data-messenger-page-id={messengerPageId}
  hidden
>
  <div class="container consent-inner">
    <p>
      ეს საიტი იყენებს cookie-ებს რეკლამების ეფექტურობის გასაზომად და საიტის გამოყენების გასაუმჯობესებლად.
      დეტალები შეგიძლიათ იხილოთ ჩვენს <a href="/privacy/">კონფიდენციალურობის პოლიტიკაში</a>.
    </p>
    <div class="consent-actions">
      <button type="button" id="consent-decline" class="btn btn-secondary">უარყოფა</button>
      <button type="button" id="consent-accept" class="btn btn-primary">მიღება</button>
    </div>
  </div>
</div>

{messengerPageId && (
  <>
    <div id="fb-root"></div>
    <div id="fb-customer-chat" class="fb-customerchat"></div>
  </>
)}

<script>
  import { loadClarity, loadGa4, loadMessengerChat, loadPixel } from '../lib/pixel';
  import { captureUtm, getConsentChoice, setConsentChoice, trackContact, trackPageView } from '../lib/tracking';

  // Ad tags only exist in the landing page's address; save them on every page
  // load so they're still there when the visitor reaches the registration form.
  captureUtm();

  const banner = document.getElementById('consent-banner') as HTMLElement;
  const acceptButton = document.getElementById('consent-accept') as HTMLButtonElement;
  const declineButton = document.getElementById('consent-decline') as HTMLButtonElement;

  function activateTracking() {
    const pixelId = banner.dataset.pixelId;
    const ga4Id = banner.dataset.ga4Id;
    const clarityId = banner.dataset.clarityId;
    const messengerPageId = banner.dataset.messengerPageId;
    if (pixelId) loadPixel(pixelId);
    if (ga4Id) loadGa4(ga4Id);
    if (clarityId) loadClarity(clarityId);
    if (messengerPageId) loadMessengerChat(messengerPageId);
    trackPageView();
  }

  function showBanner() {
    banner.hidden = false;
  }

  function hideBanner() {
    banner.hidden = true;
  }

  const existingChoice = getConsentChoice();
  if (existingChoice === 'accepted') {
    activateTracking();
  } else if (existingChoice === null) {
    showBanner();
  }

  acceptButton.addEventListener('click', () => {
    setConsentChoice('accepted');
    hideBanner();
    activateTracking();
  });

  declineButton.addEventListener('click', () => {
    setConsentChoice('declined');
    hideBanner();
  });

  // Footer "cookie settings" link reopens the banner without re-reading storage.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-reopen-consent]')) {
      event.preventDefault();
      showBanner();
    }
  });

  // Delegated Contact-link tracking lives here so it only ever fires post-consent.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-meta-contact]')) trackContact();
  });
</script>

<style>
  .consent-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--color-ink);
    color: var(--color-bg);
    border-top: 1px solid var(--color-divider);
  }

  .consent-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .consent-banner p {
    font-size: 0.85rem;
    max-width: 60ch;
  }

  .consent-banner a {
    text-decoration: underline;
  }

  .consent-actions {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .consent-banner .btn-secondary {
    border-color: var(--color-bg);
    color: var(--color-bg);
  }

  .consent-banner .btn-primary {
    background: var(--color-bg);
    color: var(--color-ink);
  }
</style>
