---
import type { CollectionEntry } from 'astro:content';
import { getCohortStartFact, getCurrentPrice } from '../lib/cohort';

interface Props {
  course: CollectionEntry<'courses'>;
}

const { course } = Astro.props;
const { title, slug, group } = course.data;
const href = `/group-courses/${slug}/`;

const startFact = getCohortStartFact({ nextStartDate: group.nextStartDate });
const scheduleFact = group.schedule || 'განრიგი მალე დაზუსტდება';
const isScheduleTba = !group.schedule;

const currentPrice = getCurrentPrice({
  price: group.price,
  earlyBirdPrice: group.earlyBirdPrice,
  earlyBirdUntil: group.earlyBirdUntil,
}).currentPrice;
---
<a href={href} class="group-course-card">
  <h2 class="latin card-name">{title}</h2>
  <p class="card-subtitle">საფუძვლები დამწყებთათვის</p>

  <ul class="card-facts">
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3.5" y="4.5" width="17" height="16" rx="1" />
        <path d="M3.5 9h17M8 3v3M16 3v3" />
      </svg>
      <span>{startFact}</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </svg>
      <span class={isScheduleTba ? 'fact-tba' : ''}>{scheduleFact}</span>
    </li>
  </ul>

  <div class="card-footer">
    <p class="card-price"><span class="num">{currentPrice}</span> <span class="lari">₾</span></p>
    <span class="card-cta">კურსის ნახვა →</span>
  </div>
</a>

<style>
  .group-course-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #cfcac0;
    padding: 36px 32px 32px;
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }

  .group-course-card:hover,
  .group-course-card:focus-visible {
    border-color: #1c1b19;
  }

  .card-name {
    font-family: var(--font-latin);
    font-size: 34px;
    font-weight: 400;
    letter-spacing: 2px;
  }

  .card-subtitle {
    margin-top: 12px;
    font-size: 16px;
    color: #55514a;
  }

  .card-facts {
    list-style: none;
    margin: 28px 0;
    padding: 24px 0;
    border-top: 1px solid #e2ded5;
    border-bottom: 1px solid #e2ded5;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-facts li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 17px;
    white-space: nowrap;
  }

  .card-facts svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .card-facts .fact-tba {
    /* Spec called for #7E7A72, but that fails WCAG contrast (3.92:1 on this
       background, needs 4.5:1) — using the site's existing muted color
       instead, which passes at 7.24:1 and serves the same purpose. */
    color: var(--color-muted);
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .card-price {
    margin: 0;
    font-size: 34px;
    font-weight: 600;
  }

  .card-price .num {
    font-family: var(--font-latin);
  }

  .card-price .lari {
    font-family: var(--font-georgian);
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    background: #1c1b19;
    color: #f7f5f0;
    font-size: 16px;
    padding: 14px 22px;
    white-space: nowrap;
  }
</style>
