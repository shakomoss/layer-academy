---
import PriceDisplay from './PriceDisplay.astro';
import FactRows, { type FactRow } from './FactRows.astro';
import InstructorFactTags from './InstructorFactTags.astro';

interface SidebarInstructor {
  name: string;
  title: string;
  oneLiner: string;
  facts?: string[];
}

interface Props {
  price: number;
  earlyBirdPrice?: number;
  earlyBirdUntil?: Date;
  suffix?: string;
  priceLabel?: string;
  seatsLeft?: number;
  facts: FactRow[];
  ctaHref: string;
  ctaLabel?: string;
  instructor?: SidebarInstructor;
}

const {
  price,
  earlyBirdPrice,
  earlyBirdUntil,
  suffix,
  priceLabel,
  seatsLeft,
  facts,
  ctaHref,
  ctaLabel = 'დარეგისტრირდით',
  instructor,
} = Astro.props;
---
<aside class="course-sidebar">
  <PriceDisplay price={price} earlyBirdPrice={earlyBirdPrice} earlyBirdUntil={earlyBirdUntil} suffix={suffix} label={priceLabel} size="large" />
  {seatsLeft != null && <p class="sidebar-seats">დარჩენილია {seatsLeft} ადგილი</p>}

  <hr class="sidebar-rule" />

  <FactRows facts={facts} />

  <a href={ctaHref} class="btn btn-primary sidebar-cta">{ctaLabel}</a>

  {instructor && (
    <>
      <hr class="sidebar-rule" />
      <p class="sidebar-instructor-label">ლექტორი</p>
      <p class="sidebar-instructor-name">{instructor.name}</p>
      <p class="sidebar-instructor-title">{instructor.title}</p>
      <p class="sidebar-instructor-oneliner">{instructor.oneLiner}</p>
      {instructor.facts && <InstructorFactTags facts={instructor.facts} />}
    </>
  )}
</aside>

<style>
  .course-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .course-sidebar {
      display: block;
      position: sticky;
      top: 32px;
      align-self: start;
      border: 1px solid #cfcac0;
      padding: 32px;
    }
  }

  .sidebar-seats {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .sidebar-rule {
    border: none;
    border-top: 1px solid var(--color-divider);
    margin: 24px 0;
  }

  .sidebar-cta {
    width: 100%;
    min-height: 56px;
    margin-top: 24px;
    justify-content: center;
  }

  .sidebar-instructor-label {
    margin: 0;
    font-size: 13px;
    color: var(--color-muted);
  }

  .sidebar-instructor-name {
    margin: 0.3rem 0 0;
    font-size: 16px;
    font-weight: 600;
  }

  .sidebar-instructor-title {
    margin: 0.1rem 0 0;
    font-size: 13px;
    color: var(--color-muted);
  }

  .sidebar-instructor-oneliner {
    margin: 0.4rem 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .sidebar-instructor-oneliner + :global(.fact-tags) {
    margin-top: 0.6rem;
  }
</style>
