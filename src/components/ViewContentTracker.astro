---
interface Props {
  contentName: string;
  contentCategory: 'group' | 'mentorship';
  value: number;
}

const { contentName, contentCategory, value } = Astro.props;
---
<span
  id="view-content-data"
  data-content-name={contentName}
  data-content-category={contentCategory}
  data-value={value}
  hidden
></span>

<script>
  import { trackViewContent } from '../lib/tracking';

  const el = document.getElementById('view-content-data') as HTMLElement | null;
  if (el?.dataset.contentName) {
    trackViewContent({
      contentName: el.dataset.contentName,
      contentCategory: el.dataset.contentCategory as 'group' | 'mentorship',
      value: Number(el.dataset.value),
    });
  }
</script>
