---
import type { CollectionEntry } from 'astro:content';
import PriceBox from './PriceBox.astro';

interface Props {
  course: CollectionEntry<'courses'>;
  instructorName?: string;
}

const { course, instructorName } = Astro.props;
const { title, slug, mentorship } = course.data;
const href = `/mentorship/${slug}/`;
---
<article class="course-card">
  <h3 class="latin">{title}</h3>
  {instructorName && <p class="course-mentor">{instructorName}</p>}
  <PriceBox price={mentorship.price} label="სრული კურსი" />
  <a href={href} class="btn btn-secondary course-link">პროგრამის ნახვა</a>
</article>

<style>
  .course-card {
    border: 1px solid var(--color-divider);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .course-card h3 {
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 300;
  }

  .course-mentor {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .course-link {
    margin-top: var(--space-2);
    align-self: flex-start;
  }
</style>
