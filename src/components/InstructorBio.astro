---
interface Props {
  name: string;
  role: string;
  bio?: string;
}

const { name, role, bio } = Astro.props;
---
<div class="instructor-bio">
  <p class="instructor-name">{name}</p>
  <p class="instructor-role">{role}</p>
  {bio && <p class="instructor-text">{bio}</p>}
</div>

<style>
  .instructor-bio {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .instructor-name {
    font-weight: 500;
    font-size: 1.1rem;
  }

  .instructor-role {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .instructor-text {
    margin-top: 0.4rem;
  }
</style>
