---
interface Props {
  name: string;
  role: string;
  bio?: string;
  linkedin: string;
}

const { name, role, bio, linkedin } = Astro.props;
---
<div class="instructor-bio">
  <p class="instructor-name">{name}</p>
  <p class="instructor-role">{role}</p>
  {bio && <p class="instructor-text">{bio}</p>}
  <a href={linkedin} class="instructor-linkedin" target="_blank" rel="noopener noreferrer">
    LinkedIn
  </a>
</div>

<style>
  .instructor-bio {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .instructor-name {
    font-weight: 500;
    font-size: 1.1rem;
  }

  .instructor-role {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .instructor-text {
    margin-top: 0.4rem;
  }

  .instructor-linkedin {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    text-decoration: underline;
    align-self: flex-start;
  }
</style>
