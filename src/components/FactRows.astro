---
export interface FactRow {
  icon: 'calendar' | 'monitor' | 'clock' | 'list' | 'award' | 'graduation-cap' | 'people' | 'play';
  text: string;
  /** Set for the "next start" row: text is the build-time value, revalidated client-side (see script below) so a cached page is never stale. */
  cohort?: boolean;
  nextStartDate?: Date;
}

interface Props {
  facts: FactRow[];
}

const { facts } = Astro.props;
---
<ul class="fact-rows">
  {facts.map((fact) => (
    <li>
      {fact.icon === 'calendar' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3.5" y="4.5" width="17" height="16" rx="1" />
          <path d="M3.5 9h17M8 3v3M16 3v3" />
        </svg>
      )}
      {fact.icon === 'monitor' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="4.5" width="18" height="12" rx="1" />
          <path d="M8.5 20h7M12 16.5V20" />
        </svg>
      )}
      {fact.icon === 'clock' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" />
          <path d="M12 7.5V12l3 2" />
        </svg>
      )}
      {fact.icon === 'list' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
      )}
      {fact.icon === 'award' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="9.5" r="5" />
          <path d="M9 13.5 7 20l5-2.5 5 2.5-2-6.5" />
        </svg>
      )}
      {fact.icon === 'graduation-cap' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 4.5 3.5 9 12 13.5 20.5 9z" />
          <path d="M7 11v4.5c0 1.5 2.2 3 5 3s5-1.5 5-3V11" />
        </svg>
      )}
      {fact.icon === 'people' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="8.5" cy="9" r="3" />
          <circle cx="16.5" cy="10" r="2.3" />
          <path d="M3.5 19c0-2.8 2.2-5 5-5s5 2.2 5 5" />
          <path d="M14.3 14.3c2.2.3 3.7 2.1 3.7 4.7" />
        </svg>
      )}
      {fact.icon === 'play' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3.5" y="5.5" width="17" height="13" rx="1" />
          <path d="M10 10l4 2.5-4 2.5z" />
        </svg>
      )}
      {fact.cohort ? (
        <span data-cohort-label data-next-start-date={fact.nextStartDate ? fact.nextStartDate.toISOString() : ''}>
          {fact.text}
        </span>
      ) : (
        <span>{fact.text}</span>
      )}
    </li>
  ))}
</ul>

<script>
  import { getCohortLabel } from '../lib/cohort';

  // Same revalidation CohortLabel.astro does on its own instances — tagging
  // these rows with the same data attributes lets one script cover both.
  document.querySelectorAll<HTMLElement>('[data-cohort-label]').forEach((el) => {
    const nextStartDate = el.dataset.nextStartDate || undefined;
    el.textContent = getCohortLabel({ nextStartDate });
  });
</script>

<style>
  .fact-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fact-rows li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 16px;
  }

  .fact-rows svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-muted);
  }
</style>
