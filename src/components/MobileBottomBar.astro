---
import PriceDisplay from './PriceDisplay.astro';

interface Props {
  price: number;
  earlyBirdPrice?: number;
  earlyBirdUntil?: Date;
  suffix?: string;
  ctaHref: string;
  ctaLabel?: string;
}

const { price, earlyBirdPrice, earlyBirdUntil, suffix, ctaHref, ctaLabel = 'დარეგისტრირდით' } = Astro.props;
---
<div class="mobile-bottom-bar">
  <PriceDisplay price={price} earlyBirdPrice={earlyBirdPrice} earlyBirdUntil={earlyBirdUntil} suffix={suffix} size="compact" />
  <a href={ctaHref} class="btn btn-primary">{ctaLabel}</a>
</div>

<style>
  .mobile-bottom-bar {
    display: none;
  }

  @media (max-width: 1023px) {
    .mobile-bottom-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 40;
      background: var(--color-bg);
      border-top: 1px solid var(--color-divider);
      padding: var(--space-2) var(--space-3);
      padding-bottom: calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
