---
import type { CollectionEntry } from 'astro:content';
import { getCurrentPrice, getShortCohortLabel } from '../lib/cohort';

interface Props {
  course: CollectionEntry<'courses'>;
}

const { course } = Astro.props;
const { title, slug, group } = course.data;
const href = `/group-courses/${slug}/`;

const startValue = getShortCohortLabel({ nextStartDate: group.nextStartDate });
const scheduleValue = group.schedule || 'მალე დაზუსტდება';
const currentPrice = getCurrentPrice({
  price: group.price,
  earlyBirdPrice: group.earlyBirdPrice,
  earlyBirdUntil: group.earlyBirdUntil,
}).currentPrice;
---
<a href={href} class="course-row">
  <div class="row-name">
    <h2 class="latin">{title}</h2>
    <p class="row-subtitle">საფუძვლები დამწყებთათვის</p>
  </div>

  <div class="row-col-meta">
    <div class="row-field">
      <p class="row-label">დაწყება</p>
      <p class="row-value">{startValue}</p>
    </div>
    <span class="row-sep" aria-hidden="true">·</span>
    <div class="row-field">
      <p class="row-label">განრიგი</p>
      <p class="row-value">{scheduleValue}</p>
    </div>
  </div>

  <div class="row-col-cta">
    <p class="row-price"><span class="num">{currentPrice}</span> <span class="lari">₾</span></p>
    <span class="row-button">კურსის ნახვა →</span>
  </div>
</a>

<style>
  .course-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding-block: 20px;
    border-bottom: 1px solid #cfcac0;
    text-decoration: none;
    color: var(--color-ink);
    transition: background-color 0.15s ease;
  }

  .course-row:hover,
  .course-row:focus-visible {
    background-color: #efece5;
  }

  .row-name h2 {
    font-family: var(--font-latin);
    font-size: 30px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 300;
  }

  .row-subtitle {
    margin-top: 0.3rem;
    font-size: 15px;
    color: var(--color-muted);
  }

  .row-col-meta {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .row-sep {
    color: var(--color-muted);
  }

  .row-label {
    display: none;
  }

  .row-value {
    margin: 0;
    font-size: 17px;
  }

  .row-col-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .row-price {
    margin: 0;
    font-size: 32px;
    font-weight: 600;
  }

  .row-price .num {
    font-family: var(--font-latin);
  }

  .row-price .lari {
    font-family: var(--font-georgian);
  }

  .row-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.7rem 1.1rem;
    background: #1c1b19;
    color: #f7f5f0;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .course-row {
      grid-template-columns: minmax(220px, 1.4fr) 1fr 1fr auto auto;
      align-items: center;
      gap: 32px;
      padding-block: 32px;
    }

    .row-col-meta,
    .row-col-cta {
      display: contents;
    }

    .row-sep {
      display: none;
    }

    .row-label {
      display: block;
      margin: 0 0 0.2rem;
      font-size: 0.8rem;
      color: var(--color-muted);
    }
  }
</style>
