---
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/noto-sans-georgian/400.css';
import '@fontsource/noto-sans-georgian/500.css';
import '@fontsource/noto-sans-georgian/600.css';
import '../styles/tokens.css';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const [settings] = await getCollection('settings');
const domainVerification = settings?.data.metaDomainVerification || '';
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID || '';
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
---
<!doctype html>
<html lang="ka">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {domainVerification && <meta name="facebook-domain-verification" content={domainVerification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">გადასვლა მთავარ კონტენტზე</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ConsentBanner pixelId={pixelId} ga4Id={ga4Id} />
  </body>
</html>
