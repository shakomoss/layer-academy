---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupCourseCard from '../../components/GroupCourseCard.astro';
import { buildBreadcrumbJsonLd } from '../../lib/structured-data';

const courses = (await getCollection('courses', ({ data }) => data.published && data.group.enabled)).sort(
  (a, b) => a.data.order - b.data.order
);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'ჯგუფური კურსები', url: new URL('/group-courses/', Astro.site).toString() },
]);
---
<BaseLayout
  title="არქიტექტურული პროგრამების კურსები - Archicad, AutoCAD, Revit, Rhino, 3ds Max | Layer Academy"
  description="არქიტექტურული პროგრამების ჯგუფური, ლაივ ონლაინ კურსები დამწყებთათვის. ახალი ნაკადი ყოველ თვე."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <section class="course-section-header">
    <h1>ჯგუფური კურსები</h1>
    <p>სწავლება სრულად ონლაინ მიმდინარეობს.</p>
  </section>

  <section class="course-grid">
    {courses.map((course) => (
      <GroupCourseCard course={course} headingLevel="h2" />
    ))}
  </section>
</BaseLayout>

<style>
  .course-section-header {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding-inline: var(--space-3);
    padding-top: var(--space-5);
  }

  .course-section-header h1 {
    font-size: 32px;
    font-weight: 600;
  }

  .course-section-header p {
    margin-top: var(--space-2);
    margin-bottom: 36px;
    font-size: 17px;
    color: #55514a;
  }

  .course-grid {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding-inline: var(--space-3);
    padding-bottom: var(--space-6);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 1023px) {
    .course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .course-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
