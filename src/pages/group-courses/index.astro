---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseRow from '../../components/CourseRow.astro';
import { buildBreadcrumbJsonLd } from '../../lib/structured-data';

const courses = (await getCollection('courses', ({ data }) => data.published && data.group.enabled)).sort(
  (a, b) => a.data.order - b.data.order
);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'ჯგუფური კურსები', url: new URL('/group-courses/', Astro.site).toString() },
]);
---
<BaseLayout
  title="არქიტექტურული პროგრამების კურსები — Archicad, AutoCAD, Revit, Rhino, 3ds Max | Layer Academy"
  description="არქიტექტურული პროგრამების ჯგუფური, ლაივ ონლაინ კურსები დამწყებთათვის. ახალი ნაკადი ყოველ თვე."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <section class="container page-intro">
    <h1>ჯგუფური კურსები</h1>
    <p>
      ყველა კურსი ჩატარდება ონლაინ, ლაივ ლექციების ფორმატში და განკუთვნილია სრულიად დამწყებთათვის. ახალი
      ნაკადი იხსნება ყოველ თვე.
    </p>
  </section>

  <section class="course-list">
    <p class="list-note">ყველა კურსი ონლაინ ტარდება, ლექციების ჩანაწერებით.</p>
    <div class="row-list">
      {courses.map((course) => (
        <CourseRow course={course} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-top: var(--space-5);
    max-width: 60ch;
  }

  .page-intro h1 {
    margin-bottom: var(--space-2);
  }

  .course-list {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding-inline: var(--space-3);
    padding-block: var(--space-4) var(--space-6);
  }

  .list-note {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-2);
  }

  .row-list {
    display: flex;
    flex-direction: column;
  }
</style>
