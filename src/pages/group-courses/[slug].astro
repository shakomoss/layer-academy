---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseSidebar from '../../components/CourseSidebar.astro';
import MobileBottomBar from '../../components/MobileBottomBar.astro';
import FactRows, { type FactRow } from '../../components/FactRows.astro';
import Syllabus from '../../components/Syllabus.astro';
import InstructorSection from '../../components/InstructorSection.astro';
import FAQ from '../../components/FAQ.astro';
import { buildFaqItems } from '../../lib/faq';
import { getInstructorForCourse } from '../../lib/instructors';
import { getCohortLabel, getCurrentPrice } from '../../lib/cohort';
import ViewContentTracker from '../../components/ViewContentTracker.astro';
import { buildBreadcrumbJsonLd, buildCourseJsonLd, buildFaqJsonLd } from '../../lib/structured-data';

export async function getStaticPaths() {
  const courses = await getCollection('courses', ({ data }) => data.published && data.group.enabled);
  return courses.map((course) => ({ params: { slug: course.data.slug }, props: { course } }));
}

const { course } = Astro.props;
const { title, slug, group, goal, outcome, syllabus, mentorship, seoTitle, seoDescription } = course.data;
const instructor = await getInstructorForCourse(slug);

const pageTitle = seoTitle || `${title} კურსი ონლაინ — საბაზისო დონე | Layer Academy`;
const pageDescription =
  seoDescription || `${title}-ის ჯგუფური, ონლაინ კურსი დამწყებთათვის. ლაივ ლექციები, საბაზისო დონე.`;
const currentPrice = getCurrentPrice({
  price: group.price,
  earlyBirdPrice: group.earlyBirdPrice,
  earlyBirdUntil: group.earlyBirdUntil,
}).currentPrice;

const registerHref = `/register/?course=${slug}&type=group`;

const facts: FactRow[] = [
  { icon: 'calendar', text: getCohortLabel({ nextStartDate: group.nextStartDate }), cohort: true, nextStartDate: group.nextStartDate },
  { icon: 'monitor', text: 'ონლაინ' },
  { icon: 'clock', text: group.schedule || 'განრიგი მალე დაზუსტდება' },
  ...(group.duration ? [{ icon: 'list' as const, text: group.duration }] : []),
  { icon: 'award', text: 'სერტიფიკატი: კურსის დასრულებისას' },
];

const pageUrl = new URL(`/group-courses/${slug}/`, Astro.site).toString();
const faqItems = buildFaqItems();
const courseJsonLd = buildCourseJsonLd({
  name: title,
  description: pageDescription,
  url: pageUrl,
  image: new URL(`/og/${slug}-group.png`, Astro.site).toString(),
  price: currentPrice,
  schedule: group.schedule,
  instructorName: instructor?.data.name,
  instructorTitle: instructor?.data.title,
  instructorOneLiner: instructor?.data.oneLiner,
});
const faqJsonLd = buildFaqJsonLd(faqItems);
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'ჯგუფური კურსები', url: new URL('/group-courses/', Astro.site).toString() },
  { name: title, url: pageUrl },
]);
---
<BaseLayout title={pageTitle} description={pageDescription} ogImage={`/og/${slug}-group.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <ViewContentTracker contentName={title} contentCategory="group" value={currentPrice} />

  <div class="container course-detail-grid">
    <article class="course-main">
      <header class="course-header">
        <h1 class="latin software-name">{title}</h1>
        <p class="course-subtitle">საფუძვლები დამწყებთათვის</p>
      </header>

      <div class="mobile-facts">
        <FactRows facts={facts} />
      </div>

      {goal && (
        <section class="course-section">
          <h2>კურსის მიზანი</h2>
          <p>{goal}</p>
        </section>
      )}

      <section class="course-section">
        <h2>რას შეისწავლით</h2>
        <Syllabus syllabus={syllabus} introText={syllabus?.topics ? 'კურსის ფარგლებში შეისწავლით:' : undefined} />
      </section>

      {outcome && (
        <section class="course-section">
          <h2>კურსის შედეგი</h2>
          <p>{outcome}</p>
        </section>
      )}

      <section class="course-section">
        <h2>ვისთვისაა კურსი</h2>
        <p>კურსი განკუთვნილია სრულიად დამწყებთათვის — წინასწარი გამოცდილება არ გჭირდებათ.</p>
      </section>

      {instructor && <InstructorSection instructor={instructor} />}

      <section class="course-section payment-note">
        <h2>გადახდა</h2>
        <p>გადახდა ინვოისით (საბანკო გადარიცხვა). დარეგისტრირების შემდეგ დაგიკავშირდებით და გამოგიწერთ ინვოისს.</p>
      </section>

      <section class="course-section">
        <h2>კითხვები და პასუხები</h2>
        <FAQ items={faqItems} />
      </section>

      {mentorship.enabled && (
        <section class="course-section cross-link">
          <p>
            გსურთ ინდივიდუალური ტემპი? <a href={`/mentorship/${slug}/`}>{title}-ის ინდივიდუალური მენტორინგი</a>
          </p>
        </section>
      )}
    </article>

    <CourseSidebar
      price={group.price}
      earlyBirdPrice={group.earlyBirdPrice}
      earlyBirdUntil={group.earlyBirdUntil}
      seatsLeft={group.seatsLeft}
      facts={facts}
      ctaHref={registerHref}
      instructor={
        instructor
          ? { name: instructor.data.name, title: instructor.data.title, oneLiner: instructor.data.oneLiner }
          : undefined
      }
    />
  </div>

  <MobileBottomBar
    price={group.price}
    earlyBirdPrice={group.earlyBirdPrice}
    earlyBirdUntil={group.earlyBirdUntil}
    ctaHref={registerHref}
  />
</BaseLayout>

<style>
  .course-detail-grid {
    padding-block: var(--space-5) var(--space-6);
    max-width: 1160px;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .course-detail-grid {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 64px;
    }
  }

  .course-main {
    max-width: 65ch;
  }

  .course-main :global(p) {
    font-size: 17px;
    line-height: 1.7;
  }

  .course-header {
    margin-bottom: var(--space-3);
  }

  .software-name {
    font-size: clamp(2.5rem, 6vw, 64px);
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .software-name {
      font-size: 64px;
    }
  }

  .course-subtitle {
    color: var(--color-muted);
    margin-top: var(--space-1);
  }

  .mobile-facts {
    margin-block: var(--space-4);
  }

  @media (min-width: 1024px) {
    .mobile-facts {
      display: none;
    }
  }

  .course-section {
    margin-block: var(--space-5);
  }

  .course-section h2 {
    margin-bottom: var(--space-2);
    font-size: 1.3rem;
  }

  .cross-link {
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-3);
  }

  .cross-link a {
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .course-detail-grid {
      padding-bottom: calc(var(--space-6) + 72px);
    }
  }
</style>
