---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseSidebar from '../../components/CourseSidebar.astro';
import MobileBottomBar from '../../components/MobileBottomBar.astro';
import FactRows, { type FactRow } from '../../components/FactRows.astro';
import Syllabus from '../../components/Syllabus.astro';
import InstructorSection from '../../components/InstructorSection.astro';
import FAQ from '../../components/FAQ.astro';
import { buildFaqItems } from '../../lib/faq';
import { getInstructorForCourse } from '../../lib/instructors';
import ViewContentTracker from '../../components/ViewContentTracker.astro';
import { buildBreadcrumbJsonLd, buildCourseJsonLd, buildFaqJsonLd } from '../../lib/structured-data';

export async function getStaticPaths() {
  const courses = await getCollection('courses', ({ data }) => data.published && data.mentorship.enabled);
  return courses.map((course) => ({ params: { slug: course.data.slug }, props: { course } }));
}

const { course } = Astro.props;
const { title, slug, mentorship, group, syllabus, seoTitle, seoDescription } = course.data;
const instructor = await getInstructorForCourse(slug);

const pageTitle = seoTitle || `${title} - ინდივიდუალური მენტორინგი | Layer Academy`;
const pageDescription =
  seoDescription || `${title}-ის ინდივიდუალური ონლაინ მენტორინგი — ყოველკვირეული 1:1 სესიები მენტორთან.`;

const registerHref = `/register/?course=${slug}&type=mentorship`;

const facts: FactRow[] = [
  { icon: 'monitor', text: 'ფორმატი: ონლაინ' },
  { icon: 'graduation-cap', text: 'დონე: დამწყები' },
  { icon: 'people', text: 'ჯგუფის ზომა: მცირე ჯგუფები' },
  { icon: 'award', text: 'სერტიფიკატი: კურსის დასრულებისას' },
  { icon: 'play', text: 'ბონუსი: ლექციების ჩანაწერები' },
];

const pageUrl = new URL(`/mentorship/${slug}/`, Astro.site).toString();
const faqItems = buildFaqItems();
const courseJsonLd = buildCourseJsonLd({
  name: `${title} — ინდივიდუალური მენტორინგი`,
  description: pageDescription,
  url: pageUrl,
  image: new URL(`/og/${slug}-mentorship.png`, Astro.site).toString(),
  price: mentorship.monthlyPrice,
  instructorName: instructor?.data.name,
  instructorTitle: instructor?.data.title,
  instructorOneLiner: instructor?.data.oneLiner,
});
const faqJsonLd = buildFaqJsonLd(faqItems);
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'ინდივიდუალური მენტორინგი', url: new URL('/mentorship/', Astro.site).toString() },
  { name: title, url: pageUrl },
]);
---
<BaseLayout title={pageTitle} description={pageDescription} ogImage={`/og/${slug}-mentorship.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <ViewContentTracker contentName={title} contentCategory="mentorship" value={mentorship.monthlyPrice} />

  <div class="container course-detail-grid">
    <article class="course-main">
      <header class="course-header">
        <h1 class="latin software-name">{title}</h1>
        <p class="course-subtitle">ინდივიდუალური მენტორინგი</p>
      </header>

      <div class="mobile-facts">
        <FactRows facts={facts} />
      </div>

      <section class="course-section">
        <h2>რას მოიცავს მენტორინგი</h2>
        <p>
          ყოველკვირეული 1:1 ონლაინ სესია მენტორთან, უკუკავშირი თქვენ ნამუშევარზე, კონსულტაცია და პასუხები
          კითხვებზე. განრიგი შეთანხმდება მენტორთან ინდივიდუალურად.
        </p>
      </section>

      <section class="course-section">
        <h2>თემები, რომლებზეც შეგიძლიათ ფოკუსირება</h2>
        <Syllabus syllabus={syllabus} introText={syllabus?.topics ? 'მენტორინგის ფარგლებში შესაძლებელია შემდეგი თემების შესწავლა:' : undefined} />
      </section>

      {instructor && <InstructorSection instructor={instructor} />}

      <section class="course-section payment-note">
        <h2>გადახდა</h2>
        <p>გადახდა ინვოისით (საბანკო გადარიცხვა), ყოველთვიურად. დარეგისტრირების შემდეგ დაგიკავშირდებით და გამოგიწერთ ინვოისს.</p>
      </section>

      <section class="course-section">
        <h2>კითხვები და პასუხები</h2>
        <FAQ items={faqItems} />
      </section>

      {group.enabled && (
        <section class="course-section cross-link">
          <p>
            გირჩევნიათ ჯგუფური ფორმატი? <a href={`/group-courses/${slug}/`}>{title}-ის ჯგუფური კურსი</a>
          </p>
        </section>
      )}
    </article>

    <CourseSidebar
      price={mentorship.monthlyPrice}
      suffix=" / თვეში"
      facts={facts}
      ctaHref={registerHref}
      instructor={
        instructor
          ? {
              name: instructor.data.name,
              title: instructor.data.title,
              oneLiner: instructor.data.oneLiner,
              facts: instructor.data.facts,
            }
          : undefined
      }
    />
  </div>

  <MobileBottomBar price={mentorship.monthlyPrice} suffix=" / თვეში" ctaHref={registerHref} />
</BaseLayout>

<style>
  .course-detail-grid {
    padding-block: var(--space-5) var(--space-6);
    max-width: 1160px;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .course-detail-grid {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 64px;
    }
  }

  .course-main {
    max-width: 65ch;
  }

  .course-main :global(p) {
    font-size: 17px;
    line-height: 1.7;
  }

  .course-header {
    margin-bottom: var(--space-3);
  }

  .software-name {
    font-size: clamp(2.5rem, 6vw, 64px);
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .software-name {
      font-size: 64px;
    }
  }

  .course-subtitle {
    color: var(--color-muted);
    margin-top: var(--space-1);
  }

  .mobile-facts {
    margin-block: var(--space-4);
  }

  @media (min-width: 1024px) {
    .mobile-facts {
      display: none;
    }
  }

  .course-section {
    margin-block: var(--space-5);
  }

  .course-section h2 {
    margin-bottom: var(--space-2);
    font-size: 1.3rem;
  }

  .cross-link {
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-3);
  }

  .cross-link a {
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .course-detail-grid {
      padding-bottom: calc(var(--space-6) + 72px);
    }
  }
</style>
