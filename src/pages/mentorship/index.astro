---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import FactRows, { type FactRow } from '../../components/FactRows.astro';
import { getInstructorForCourse } from '../../lib/instructors';
import { buildBreadcrumbJsonLd } from '../../lib/structured-data';

const facts: FactRow[] = [
  { icon: 'monitor', text: 'ფორმატი: 1:1 ონლაინ' },
  { icon: 'list', text: 'პროგრამა: კურსის სილაბუსი' },
  { icon: 'clock', text: 'განრიგი: მოქნილი' },
  { icon: 'graduation-cap', text: 'დონე: დამწყები' },
];

const courses = (await getCollection('courses', ({ data }) => data.published && data.mentorship.enabled)).sort(
  (a, b) => a.data.order - b.data.order
);

const coursesWithInstructor = await Promise.all(
  courses.map(async (course) => ({
    course,
    instructor: await getInstructorForCourse(course.data.slug),
  }))
);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'ინდივიდუალური მენტორინგი', url: new URL('/mentorship/', Astro.site).toString() },
]);
---
<BaseLayout
  title="ინდივიდუალური მენტორინგი - არქიტექტურული პროგრამები | Layer Academy"
  description="იგივე კურსი და იგივე სილაბუსი, ინდივიდუალურად — Archicad, AutoCAD, Revit, Rhino, 3ds Max. 1:1 ონლაინ შეხვედრები ლექტორთან."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <section class="container page-intro">
    <h1>ინდივიდუალური მენტორინგი</h1>
    <p>
      იგივე კურსი და იგივე სილაბუსი, ოღონდ ინდივიდუალურად: 1:1 ონლაინ შეხვედრები ლექტორთან, თქვენთვის
      მოსახერხებელ დროს და თქვენს ტემპში. დაწყება ნებისმიერ დროს შეგიძლიათ.
    </p>
    <FactRows facts={facts} />
  </section>

  <section class="container course-grid">
    {coursesWithInstructor.map(({ course, instructor }) => (
      <CourseCard course={course} instructorName={instructor?.data.name} />
    ))}
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-top: var(--space-5);
    max-width: 60ch;
  }

  .page-intro h1 {
    margin-bottom: var(--space-2);
  }

  .page-intro :global(.fact-rows) {
    margin-top: var(--space-3);
  }

  .course-grid {
    padding-block: var(--space-4) var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .course-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .course-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
