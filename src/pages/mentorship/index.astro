---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const programs = (await getCollection('courses', ({ data }) => data.published && data.mentorship.enabled)).sort(
  (a, b) => a.data.order - b.data.order
);
const instructors = await getCollection('instructors');
const who = (slug: string) => instructors.find((i) => i.data.courses.includes(slug))?.data;
const I: Record<string, string> = {
  people: '<circle cx="8" cy="8" r="3"/><circle cx="16.5" cy="8" r="3"/><path d="M2.5 19c.6-3 2.8-5 5.5-5s4.9 2 5.5 5M11 19c.6-3 2.8-5 5.5-5s4.9 2 5.5 5"/>',
  book: '<rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  cap: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/>',
};
const facts: [string, string, string][] = [
  ['people', 'ფორმატი', '1:1 ონლაინ'],
  ['book', 'პროგრამა', 'კურსის სილაბუსი'],
  ['clock', 'განრიგი', 'მოქნილი'],
  ['cap', 'დონე', 'დამწყები'],
];
---
<BaseLayout title="ინდივიდუალური მენტორინგი - Layer Academy">
  <div class="mt-wrap">
    <h1>ინდივიდუალური მენტორინგი</h1>
    <p class="mt-lead">იგივე კურსი და იგივე სილაბუსი, ოღონდ ინდივიდუალურად: 1:1 ონლაინ შეხვედრები ლექტორთან, თქვენთვის მოსახერხებელ დროს და თქვენს ტემპში. დაწყება ნებისმიერ დროს შეგიძლიათ.</p>

    <div class="mt-strip">
      {facts.map(([icon, l, v]) => (
        <div class="mt-c">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1C1B19" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={I[icon]} />
          <span class="mt-l">{l}</span>
          <span class="mt-v">{v}</span>
        </div>
      ))}
    </div>

    <div class="mt-grid">
      {programs.map((p) => {
        const i = who(p.data.slug);
        return (
          <a class="mt-card" href={`/mentorship/${p.data.slug}/`}>
            <div class="mt-name">{p.data.title.toUpperCase()}</div>
            {i && (<><div class="mt-who">{i.name}</div><div class="mt-role">{i.title}</div></>)}
            <div class="mt-foot">
              <div class="mt-pl">სრული კურსი</div>
              <div class="mt-price">{p.data.mentorship.price} <span class="mt-lari">₾</span></div>
              <span class="mt-btn">პროგრამის ნახვა →</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .mt-wrap { max-width: 1160px; margin: 0 auto; padding: 72px 40px; }
  .mt-wrap h1 { font-size: clamp(32px, 4vw, 44px); font-weight: 600; margin: 0 0 14px; }
  .mt-lead { font-size: 18px; line-height: 1.7; color: #55514A; max-width: 62ch; margin: 0 0 40px; }

  .mt-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid #1C1B19; border-bottom: 1px solid #1C1B19; margin-bottom: 56px; }
  .mt-c { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 26px 12px; text-align: center; }
  .mt-c + .mt-c { border-left: 1px solid #CFCAC0; }
  .mt-l { font-size: 15px; color: #7E7A72; }
  .mt-v { font-size: 18px; font-weight: 600; white-space: nowrap; }

  .mt-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .mt-card { border: 1px solid #CFCAC0; padding: 36px 32px 32px; display: flex; flex-direction: column; color: #1C1B19; text-decoration: none; transition: border-color .2s; }
  .mt-card:hover { border-color: #1C1B19; }
  .mt-name { font-family: 'Jost', sans-serif; font-size: 34px; letter-spacing: 2px; line-height: 1; }
  .mt-who { font-size: 16px; font-weight: 500; margin-top: 16px; }
  .mt-role { font-size: 15px; color: #55514A; margin: 4px 0 28px; line-height: 1.5; }
  .mt-foot { margin-top: auto; display: flex; flex-direction: column; padding-top: 22px; border-top: 1px solid #E2DED5; }
  .mt-pl { font-size: 14px; color: #7E7A72; margin-bottom: 4px; }
  .mt-price { font-size: 30px; font-weight: 600; margin-bottom: 18px; }
  .mt-lari { font-family: 'Noto Sans Georgian', sans-serif; }
  .mt-btn { background: #1C1B19; color: #F7F5F0; font-size: 16px; font-weight: 500; padding: 15px 18px; text-align: center; }

  @media (max-width: 1024px) {
    .mt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mt-strip { grid-template-columns: repeat(2, 1fr); }
    .mt-c:nth-child(3) { border-left: none; }
    .mt-c:nth-child(n+3) { border-top: 1px solid #CFCAC0; }
  }
  @media (max-width: 640px) { .mt-grid { grid-template-columns: 1fr; } }
</style>
