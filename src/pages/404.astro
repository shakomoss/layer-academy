---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="გვერდი არ მოიძებნა - Layer Academy" noindex>
  <section class="container not-found">
    <p class="not-found-code">404</p>
    <h1>გვერდი არ მოიძებნა</h1>
    <p>სამწუხაროდ, თქვენ მიერ მოთხოვნილი გვერდი არ არსებობს ან გადატანილია.</p>
    <a href="/" class="btn btn-primary">მთავარ გვერდზე დაბრუნება</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .not-found-code {
    font-family: var(--font-latin);
    font-size: 3rem;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .not-found .btn {
    margin-top: var(--space-2);
  }
</style>
