---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBreadcrumbJsonLd } from '../../lib/structured-data';

const [settings] = await getCollection('settings');
const contactEmail = settings?.data.contactEmail || '';

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'კონფიდენციალურობის პოლიტიკა', url: new URL('/privacy/', Astro.site).toString() },
]);
---
<BaseLayout
  title="კონფიდენციალურობის პოლიტიკა | Layer Academy"
  description="რა მონაცემებს ვაგროვებთ, რისთვის ვიყენებთ, ვის ვუზიარებთ და როგორ შეგიძლიათ მათი წაშლის მოთხოვნა."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="container legal-page">
    <h1>კონფიდენციალურობის პოლიტიკა</h1>
    <p class="legal-updated">ბოლო განახლება: 2026 წლის 22 ოქტომბერი</p>

    <section>
      <h2>ვინ ვართ</h2>
      <p>
        Layer Academy ატარებს არქიტექტურული და საინჟინრო პროგრამების (Archicad, AutoCAD, Revit, Rhino,
        3ds Max) ონლაინ ჯგუფურ კურსებს და ინდივიდუალურ მენტორინგს. ეს პოლიტიკა განმარტავს, როგორ
        ვამუშავებთ თქვენს მონაცემებს საიტზე layeracademy.ge.
        {contactEmail && <> კონფიდენციალურობასთან დაკავშირებული ნებისმიერი კითხვისთვის მოგვწერეთ: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</>}
      </p>
    </section>

    <section>
      <h2>რა მონაცემებს ვაგროვებთ</h2>
      <h3>რეგისტრაციის ფორმა</h3>
      <p>როცა რეგისტრირდებით, ვიღებთ მხოლოდ იმას, რასაც თავად მიუთითებთ:</p>
      <ul>
        <li>სახელი და გვარი;</li>
        <li>ტელეფონის ნომერი;</li>
        <li>ელ-ფოსტა (არასავალდებულო);</li>
        <li>არჩეული პროგრამა და ფორმატი (ჯგუფური ან ინდივიდუალური);</li>
        <li>კონტაქტის სასურველი ხერხი;</li>
        <li>კომენტარი (არასავალდებულო).</li>
      </ul>
      <p>
        ამასთან ერთად ავტომატურად ფიქსირდება გვერდის მისამართი, საიდანაც გაიგზავნა ფორმა, და სარეკლამო
        ბმულის პარამეტრები (UTM), თუ საიტზე რეკლამიდან მოხვდით — ეს გვეხმარება გავიგოთ, რომელი რეკლამა მუშაობს.
      </p>

      <h3>Cookie-ები და ანალიტიკა (მხოლოდ თქვენი თანხმობით)</h3>
      <p>
        თუ cookie-ების შეტყობინებაში დააჭერთ „მიღებას“, ჩაირთვება Meta Pixel, რომელიც აფიქსირებს
        საიტზე თქვენს მოქმედებებს: გვერდების ნახვას, კურსის გვერდის გახსნას, საკონტაქტო ბმულზე
        (ტელეფონი, WhatsApp, ელ-ფოსტა) დაჭერას და რეგისტრაციას. ამისთვის Meta იყენებს თავის cookie-ებს
        (<code>_fbp</code>, <code>_fbc</code>) და ბრაუზერის ტექნიკურ მონაცემებს (მაგ. IP მისამართი, ბრაუზერის ტიპი).
      </p>
      <p>თანხმობის გარეშე არცერთი სარეკლამო ან ანალიტიკური ინსტრუმენტი არ ჩაირთვება.</p>

      <h3>უსაფრთხოება</h3>
      <p>
        რეგისტრაციის ფორმა დაცულია Cloudflare Turnstile-ით, რომელიც ტექნიკური სიგნალების (მაგ. ბრაუზერის
        მახასიათებლები, IP მისამართი) მეშვეობით ამოწმებს, რომ ფორმას ავსებს ადამიანი და არა ბოტი.
      </p>
    </section>

    <section>
      <h2>რისთვის ვიყენებთ მონაცემებს</h2>
      <ul>
        <li>რეგისტრაციის შემდეგ თქვენთან დასაკავშირებლად, დეტალების დასაზუსტებლად და ინვოისის გამოსაწერად;</li>
        <li>რეგისტრაციის დამადასტურებელი ელ-წერილის გამოსაგზავნად (თუ ელ-ფოსტა მიუთითეთ);</li>
        <li>რეკლამების ეფექტურობის გასაზომად და გასაუმჯობესებლად — მხოლოდ თქვენი თანხმობით;</li>
        <li>საიტის სპამისა და ბოტებისგან დასაცავად.</li>
      </ul>
      <p>თქვენს მონაცემებს არ ვყიდით და არ ვიყენებთ ზემოთ ჩამოთვლილის გარდა სხვა მიზნით.</p>
    </section>

    <section>
      <h2>ვის ვუზიარებთ მონაცემებს</h2>
      <p>ვიყენებთ რამდენიმე სანდო მომსახურებას, რომლებიც მონაცემებს ამუშავებენ მხოლოდ ჩვენი დავალებით:</p>
      <ul>
        <li><strong>Cloudflare</strong> — საიტის ჰოსტინგი, რეგისტრაციის ფორმის დამუშავება და ბოტებისგან დაცვა (Turnstile);</li>
        <li><strong>Resend</strong> — რეგისტრაციის შესახებ ელ-წერილების გაგზავნა;</li>
        <li>
          <strong>Meta Platforms</strong> (Facebook/Instagram) — რეკლამის შედეგების გაზომვა, მხოლოდ თქვენი
          თანხმობის შემთხვევაში. რეგისტრაციისას Meta-ს ასევე ეგზავნება თქვენი ელ-ფოსტა და ტელეფონი
          <strong>დაშიფრული (hash) სახით</strong> — ანუ არა თავად მისამართი და ნომერი, არამედ მათგან
          მიღებული შეუქცევადი კოდი, რომლითაც Meta ადგენს, რომელმა რეკლამამ მოიყვანა რეგისტრაცია.
        </li>
      </ul>
      <p>
        ეს კომპანიები შესაძლოა მონაცემებს ამუშავებდნენ საქართველოს ფარგლებს გარეთ (მაგ. ევროკავშირში ან
        აშშ-ში), საკუთარი უსაფრთხოებისა და კონფიდენციალურობის სტანდარტების შესაბამისად.
      </p>
    </section>

    <section>
      <h2>მონაცემების შენახვა</h2>
      <p>
        საიტს არ აქვს საკუთარი მონაცემთა ბაზა. რეგისტრაციის მონაცემები ინახება მხოლოდ ჩვენს ელ-ფოსტაში
        და ვინახავთ მათ იმდენ ხანს, რამდენიც საჭიროა თქვენთან კომუნიკაციისთვის, სწავლის პროცესისა და
        ბუღალტრული აღრიცხვისთვის. რეგისტრაცია, რომელიც არ გადაიზარდა სწავლაში, იშლება გონივრულ ვადაში.
      </p>
      <p>
        თქვენი cookie-ების არჩევანი („მიღება“ ან „უარყოფა“) ინახება თქვენსავე ბრაუზერში, რომ ყოველ
        ვიზიტზე ხელახლა არ გკითხოთ.
      </p>
    </section>

    <section>
      <h2>თქვენი უფლებები</h2>
      <p>ნებისმიერ დროს შეგიძლიათ მოითხოვოთ:</p>
      <ul>
        <li>ინფორმაცია, რა მონაცემები გვაქვს თქვენ შესახებ;</li>
        <li>არაზუსტი მონაცემების შესწორება;</li>
        <li>თქვენი მონაცემების წაშლა;</li>
        <li>სარეკლამო თანხმობის გაუქმება.</li>
      </ul>
      <p>
        მოთხოვნისთვის დაგვიკავშირდით
        {contactEmail ? <> მისამართზე <a href={`mailto:${contactEmail}`}>{contactEmail}</a></> : <> <a href="/contact/">საკონტაქტო გვერდზე</a> მითითებული ხერხით</>}.
        cookie-ების თანხმობის შეცვლა შეგიძლიათ თავად, საიტის ქვედა ნაწილში ბმულით „Cookie-ების პარამეტრები“.
      </p>
      <p>
        თუ ფიქრობთ, რომ თქვენი მონაცემები არასწორად მუშავდება, გაქვთ უფლება მიმართოთ საქართველოს
        პერსონალურ მონაცემთა დაცვის სამსახურს.
      </p>
    </section>

    <section>
      <h2>არასრულწლოვნები</h2>
      <p>
        თუ 18 წლამდე ხართ, გთხოვთ, რეგისტრაციამდე ამის შესახებ აცნობოთ მშობელს ან კანონიერ წარმომადგენელს.
      </p>
    </section>

    <section>
      <h2>ცვლილებები</h2>
      <p>
        ეს პოლიტიკა შესაძლოა განახლდეს, მაგალითად, თუ საიტზე ახალ ინსტრუმენტს დავამატებთ. მოქმედი
        ვერსია ყოველთვის ხელმისაწვდომია ამ გვერდზე, განახლების თარიღით.
      </p>
    </section>

    <p class="legal-note">
      ეს დოკუმენტი მომზადებულია საიტის რეალური ფუნქციონირების საფუძველზე, თუმცა არ წარმოადგენს
      იურიდიულ კონსულტაციას. რეკომენდირებულია მისი გადამოწმება იურისტთან.
    </p>
  </article>
</BaseLayout>

<style>
  .legal-page {
    padding-block: var(--space-5) var(--space-6);
    max-width: 65ch;
  }

  .legal-page h1 {
    margin-bottom: var(--space-1);
  }

  .legal-updated {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }

  .legal-page section {
    margin-block: var(--space-4);
  }

  .legal-page section > p + p {
    margin-top: var(--space-1);
  }

  .legal-page h2 {
    margin-bottom: var(--space-1);
    font-size: 1.15rem;
  }

  .legal-page h3 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
    font-size: 1rem;
  }

  .legal-page ul {
    margin: var(--space-1) 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legal-page code {
    font-size: 0.9em;
  }

  .legal-note {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-divider);
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>
