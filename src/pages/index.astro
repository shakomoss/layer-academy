---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import GroupCourseCard from '../components/GroupCourseCard.astro';
import InstructorFactTags from '../components/InstructorFactTags.astro';
import FAQ from '../components/FAQ.astro';
import { buildFaqItems } from '../lib/faq';
import { getCurrentPrice } from '../lib/cohort';
import { buildEducationalOrganization, buildFaqJsonLd } from '../lib/structured-data';

const groupCourses = (await getCollection('courses', ({ data }) => data.published && data.group.enabled)).sort(
  (a, b) => a.data.order - b.data.order
);
const mentorshipCourses = await getCollection('courses', ({ data }) => data.published && data.mentorship.enabled);

const allCourses = await getCollection('courses', ({ data }) => data.published);
const courseTitleBySlug = new Map(allCourses.map((c) => [c.data.slug, c.data.title]));

const instructors = await Promise.all(
  (await getCollection('instructors')).map(async (instructor) => {
    const { Content } = await render(instructor);
    const programsLabel = instructor.data.courses
      .map((slug) => courseTitleBySlug.get(slug))
      .filter((title): title is string => Boolean(title))
      .map((title) => title.toUpperCase())
      .join(' · ');
    return { ...instructor, Content, programsLabel };
  })
);

const fromGroupPrice = Math.min(
  ...groupCourses.map((c) => getCurrentPrice({ price: c.data.group.price, earlyBirdPrice: c.data.group.earlyBirdPrice, earlyBirdUntil: c.data.group.earlyBirdUntil }).currentPrice)
);
const fromMentorshipPrice = Math.min(...mentorshipCourses.map((c) => c.data.mentorship.monthlyPrice));

const faqItems = buildFaqItems();
const organizationJsonLd = buildEducationalOrganization(Astro.site?.toString() ?? '');
const faqJsonLd = buildFaqJsonLd(faqItems);
---
<BaseLayout
  title="Layer Academy — არქიტექტურული პროგრამების კურსები ონლაინ"
  description="ისწავლეთ Archicad, AutoCAD, Revit, Rhino და 3ds Max ნულიდან — ჯგუფური კურსები და ინდივიდუალური მენტორინგი ონლაინ, დამწყებთათვის."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="container hero">
    <Wordmark />
    <h1>ისწავლეთ არქიტექტურული პროგრამები ნულიდან, ონლაინ</h1>
    <div class="hero-actions">
      <a href="/group-courses/" class="btn btn-primary">ჯგუფური კურსები</a>
      <a href="/mentorship/" class="btn btn-secondary">ინდივიდუალური მენტორინგი</a>
    </div>
  </section>

  <section class="container ways-to-learn">
    <h2>ორი გზა სასწავლებლად</h2>
    <div class="ways-grid">
      <article class="way-card">
        <h3>ჯგუფური კურსები</h3>
        <p>
          ლაივ ონლაინ ლექციები ჩატარდება ჯგუფში, ახალი ნაკადი იხსნება ყოველ თვე. შესაფერისია
          სტრუქტურირებული, ეტაპობრივი სწავლის მოყვარულთათვის.
        </p>
        <p class="way-price">კურსები {fromGroupPrice} ₾-დან</p>
        <a href="/group-courses/" class="btn btn-secondary">კურსების ნახვა</a>
      </article>
      <article class="way-card">
        <h3>ინდივიდუალური მენტორინგი</h3>
        <p>
          ყოველკვირეული 1:1 ონლაინ სესია მენტორთან, თქვენი ტემპითა და მიზნების მიხედვით. დაწყება
          შესაძლებელია ნებისმიერ დროს.
        </p>
        <p class="way-price">მენტორინგი {fromMentorshipPrice} ₾-დან / თვეში</p>
        <a href="/mentorship/" class="btn btn-secondary">პროგრამების ნახვა</a>
      </article>
    </div>
  </section>

  <section class="group-courses-preview">
    <div class="group-courses-header">
      <h2>ჯგუფური კურსები</h2>
      <p>ყველა კურსი ონლაინ ტარდება. ლექციების ჩანაწერები გეგზავნებათ.</p>
    </div>
    <div class="group-courses-grid">
      {groupCourses.map((course) => (
        <GroupCourseCard course={course} />
      ))}
    </div>
  </section>

  <section class="container how-it-works">
    <h2>როგორ მუშაობს</h2>
    <ol class="steps">
      <li>
        <span class="step-number">01</span>
        <p>დარეგისტრირდით კურსზე ან მენტორინგზე მოსახერხებელი ფორმის საშუალებით.</p>
      </li>
      <li>
        <span class="step-number">02</span>
        <p>დაგიკავშირდებით და გამოგიწერთ ინვოისს გადასახდელად.</p>
      </li>
      <li>
        <span class="step-number">03</span>
        <p>სწავლას დაიწყებთ შეთანხმებულ დროზე.</p>
      </li>
    </ol>
  </section>

  <section class="lecturers">
    <div class="lecturers-header">
      <h2>ლექტორები</h2>
      <p>ყველა ლექტორი პრაქტიკოსია და დარგში ყოველდღე მუშაობს.</p>
    </div>
    <div class="lecturers-grid">
      {instructors.map(({ data, Content, programsLabel }) => (
        <div class="lecturer-block">
          <p class="lecturer-title">{data.title}</p>
          {programsLabel && <p class="lecturer-programs latin">{programsLabel}</p>}
          <InstructorFactTags facts={data.facts} />
          <div class="lecturer-body">
            <Content />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container faq">
    <h2>კითხვები და პასუხები</h2>
    <FAQ items={faqItems} />
  </section>

  <section class="container final-cta">
    <h2>მზად ხართ დასაწყებად?</h2>
    <p>აირჩიეთ ჯგუფური კურსი ან ინდივიდუალური მენტორინგი და დარეგისტრირდით დღესვე.</p>
    <div class="hero-actions">
      <a href="/group-courses/" class="btn btn-primary">ჯგუფური კურსები</a>
      <a href="/mentorship/" class="btn btn-secondary">ინდივიდუალური მენტორინგი</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 24ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .ways-to-learn,
  .group-courses-preview,
  .how-it-works,
  .lecturers,
  .faq,
  .final-cta {
    padding-block: var(--space-5);
  }

  .ways-to-learn h2,
  .how-it-works h2,
  .faq h2,
  .final-cta h2 {
    margin-bottom: var(--space-3);
  }

  .ways-grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .ways-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .group-courses-header,
  .group-courses-grid {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .group-courses-header h2 {
    font-size: 32px;
    font-weight: 600;
  }

  .group-courses-header p {
    margin-top: var(--space-2);
    margin-bottom: 36px;
    font-size: 17px;
    color: #55514a;
  }

  .group-courses-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 1023px) {
    .group-courses-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .group-courses-grid {
      grid-template-columns: 1fr;
    }
  }

  .way-card,
  .instructor-card {
    border: 1px solid var(--color-divider);
    padding: var(--space-3);
  }

  .way-card h3 {
    margin-bottom: var(--space-2);
  }

  .way-price {
    font-family: var(--font-latin);
    margin-block: var(--space-2);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .steps li {
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-2);
  }

  .step-number {
    font-family: var(--font-latin);
    color: var(--color-muted);
    display: block;
    margin-bottom: 0.4rem;
  }

  .lecturers-header {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .lecturers-header h2 {
    font-size: 32px;
    font-weight: 600;
  }

  .lecturers-header p {
    margin-top: var(--space-2);
    font-size: 17px;
    color: var(--color-muted);
  }

  .lecturers-grid {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-3);
    margin-top: var(--space-4);
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .lecturers-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .lecturer-block {
    border-top: 1px solid var(--color-divider);
    padding-top: 32px;
  }

  .lecturer-title {
    font-size: 22px;
    font-weight: 600;
  }

  .lecturer-programs {
    margin-top: 0.5rem;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .lecturer-block :global(.fact-tags) {
    margin-top: var(--space-2);
  }

  .lecturer-body {
    margin-top: var(--space-3);
    max-width: 60ch;
  }

  .lecturer-body :global(p) {
    font-size: 17px;
    line-height: 1.7;
    margin-top: var(--space-2);
  }

  .lecturer-body :global(p:first-child) {
    margin-top: 0;
  }

  .final-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
</style>
