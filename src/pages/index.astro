---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GroupCourseCard from '../components/GroupCourseCard.astro';
import InstructorFactTags from '../components/InstructorFactTags.astro';
import TwoWays from '../components/TwoWays.astro';
import FAQ from '../components/FAQ.astro';
import { buildFaqItems } from '../lib/faq';
import { buildEducationalOrganization, buildFaqJsonLd } from '../lib/structured-data';

const groupCourses = (await getCollection('courses', ({ data }) => data.published && data.group.enabled)).sort(
  (a, b) => a.data.order - b.data.order
);

const allCourses = await getCollection('courses', ({ data }) => data.published);
const courseTitleBySlug = new Map(allCourses.map((c) => [c.data.slug, c.data.title]));

const instructors = await Promise.all(
  (await getCollection('instructors')).map(async (instructor) => {
    const { Content } = await render(instructor);
    const programsLabel = instructor.data.courses
      .map((slug) => courseTitleBySlug.get(slug))
      .filter((title): title is string => Boolean(title))
      .map((title) => title.toUpperCase())
      .join(' · ');
    return { ...instructor, Content, programsLabel };
  })
);

const faqItems = buildFaqItems();
const organizationJsonLd = buildEducationalOrganization(Astro.site?.toString() ?? '');
const faqJsonLd = buildFaqJsonLd(faqItems);
---
<BaseLayout
  title="Layer Academy — არქიტექტურული პროგრამების კურსები ონლაინ"
  description="ისწავლეთ Archicad, AutoCAD, Revit, Rhino და 3ds Max ნულიდან — ჯგუფური კურსები და ინდივიდუალური მენტორინგი ონლაინ, დამწყებთათვის."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="container hero">
    <h1>ისწავლეთ არქიტექტურული პროგრამები<br />ნულიდან, ონლაინ</h1>
    <p class="hero-software latin">AUTOCAD · ARCHICAD · REVIT · RHINO · 3DS MAX</p>
    <div class="hero-actions">
      <a href="/group-courses/" class="btn btn-primary">ჯგუფური კურსები</a>
      <a href="/mentorship/" class="btn btn-secondary">ინდივიდუალური მენტორინგი</a>
    </div>
    <div class="hero-facts">
      <div class="hero-fact">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="4.5" width="18" height="12" rx="1" />
          <path d="M8.5 20h7M12 16.5V20" />
        </svg>
        <p class="fact-label">ფორმატი</p>
        <p class="fact-value">ონლაინ</p>
      </div>
      <div class="hero-fact">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 4.5 3.5 9 12 13.5 20.5 9z" />
          <path d="M7 11v4.5c0 1.5 2.2 3 5 3s5-1.5 5-3V11" />
        </svg>
        <p class="fact-label">დონე</p>
        <p class="fact-value">დამწყები</p>
      </div>
      <div class="hero-fact">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="8.5" cy="9" r="3" />
          <circle cx="16.5" cy="10" r="2.3" />
          <path d="M3.5 19c0-2.8 2.2-5 5-5s5 2.2 5 5" />
          <path d="M14.3 14.3c2.2.3 3.7 2.1 3.7 4.7" />
        </svg>
        <p class="fact-label">ჯგუფის ზომა</p>
        <p class="fact-value">მცირე ჯგუფები</p>
      </div>
      <div class="hero-fact">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="9.5" r="5" />
          <path d="M9 13.5 7 20l5-2.5 5 2.5-2-6.5" />
        </svg>
        <p class="fact-label">სერტიფიკატი</p>
        <p class="fact-value">კურსის დასრულებისას</p>
      </div>
      <div class="hero-fact">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3.5" y="5.5" width="17" height="13" rx="1" />
          <path d="M10 10l4 2.5-4 2.5z" />
        </svg>
        <p class="fact-label">ბონუსი</p>
        <p class="fact-value">ლექციების ჩანაწერები</p>
      </div>
    </div>
  </section>

  <TwoWays />

  <section class="group-courses-preview">
    <div class="group-courses-header">
      <h2>ჯგუფური კურსები</h2>
      <p>სწავლება სრულად ონლაინ მიმდინარეობს.</p>
    </div>
    <div class="group-courses-grid">
      {groupCourses.map((course) => (
        <GroupCourseCard course={course} />
      ))}
    </div>
  </section>

  <section class="lecturers">
    <div class="lecturers-header">
      <h2>ლექტორები</h2>
    </div>
    <div class="lecturers-divider"></div>
    <div class="lecturers-grid">
      {instructors.map(({ data, Content, programsLabel }) => (
        <div class="lecturer-block">
          <p class="lecturer-name">{data.name}</p>
          <p class="lecturer-title">{data.title}</p>
          {programsLabel && <p class="lecturer-programs latin">{programsLabel}</p>}
          <InstructorFactTags facts={data.facts} />
          <div class="lecturer-body">
            <Content />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container faq">
    <h2>კითხვები და პასუხები</h2>
    <FAQ items={faqItems} />
  </section>

  <section class="container final-cta">
    <h2>მზად ხართ დასაწყებად?</h2>
    <p>აირჩიეთ ჯგუფური კურსი ან ინდივიდუალური მენტორინგი და დარეგისტრირდით დღესვე.</p>
    <div class="hero-actions">
      <a href="/group-courses/" class="btn btn-primary">ჯგუფური კურსები</a>
      <a href="/mentorship/" class="btn btn-secondary">ინდივიდუალური მენტორინგი</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 96px 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 500;
    line-height: 1.2;
    max-width: 960px;
  }

  .hero h1 br {
    display: none;
  }

  @media (min-width: 760px) {
    .hero h1 br {
      display: inline;
    }
  }

  .hero-software {
    margin-top: 24px;
    font-size: 18px;
    letter-spacing: 4px;
    color: #55514a;
  }

  .hero > .hero-actions {
    margin-top: 40px;
  }

  .hero-facts {
    margin-top: 64px;
    width: 100%;
    max-width: 1160px;
    border-top: 1px solid #1c1b19;
    border-bottom: 1px solid #1c1b19;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .hero-fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 28px 16px;
  }

  .hero-fact:not(:first-child) {
    border-left: 1px solid #cfcac0;
  }

  .hero-fact svg {
    width: 24px;
    height: 24px;
    color: var(--color-ink);
  }

  .hero-fact .fact-label {
    font-size: 15px;
    color: #7e7a72;
  }

  .hero-fact .fact-value {
    font-size: 18px;
    font-weight: 600;
    color: #1c1b19;
  }

  @media (min-width: 1024px) {
    .hero-fact .fact-value {
      white-space: nowrap;
    }
  }

  @media (max-width: 1023px) {
    .hero-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-fact:not(:first-child) {
      border-left: none;
    }

    .hero-fact:nth-child(3n + 2),
    .hero-fact:nth-child(3n) {
      border-left: 1px solid #cfcac0;
    }

    .hero-fact:nth-child(n + 4) {
      border-top: 1px solid #cfcac0;
    }
  }

  @media (max-width: 639px) {
    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-fact:nth-child(3n + 2),
    .hero-fact:nth-child(3n) {
      border-left: none;
    }

    .hero-fact:nth-child(even) {
      border-left: 1px solid #cfcac0;
    }

    .hero-fact:nth-child(n + 3) {
      border-top: 1px solid #cfcac0;
    }

    .hero-fact:last-child {
      grid-column: span 2;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .group-courses-preview,
  .lecturers,
  .faq,
  .final-cta {
    padding-block: var(--space-5);
  }

  .faq h2,
  .final-cta h2 {
    margin-bottom: var(--space-3);
  }

  .group-courses-header,
  .group-courses-grid {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .group-courses-header h2 {
    font-size: 32px;
    font-weight: 600;
  }

  .group-courses-header p {
    margin-top: var(--space-2);
    margin-bottom: 36px;
    font-size: 17px;
    color: #55514a;
  }

  .group-courses-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 1023px) {
    .group-courses-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .group-courses-grid {
      grid-template-columns: 1fr;
    }
  }

  .instructor-card {
    border: 1px solid var(--color-divider);
    padding: var(--space-3);
  }

  .lecturers-header {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .lecturers-header h2 {
    font-size: 32px;
    font-weight: 600;
  }

  .lecturers-divider {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-3);
    margin-top: 32px;
    border-top: 1px solid #cfcac0;
  }

  .lecturers-grid {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-3);
    margin-top: var(--space-4);
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .lecturers-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .lecturer-block:nth-child(even) {
      border-left: 1px solid #cfcac0;
      padding-left: 48px;
    }
  }

  @media (max-width: 899px) {
    .lecturers-grid {
      gap: 0;
    }

    .lecturer-block:not(:first-child) {
      margin-top: 40px;
      padding-top: 40px;
      border-top: 1px solid #cfcac0;
    }
  }

  .lecturer-name {
    font-size: 22px;
    font-weight: 600;
  }

  .lecturer-title {
    margin-top: 0.2rem;
    font-size: 16px;
    color: var(--color-muted);
  }

  .lecturer-programs {
    margin-top: 0.5rem;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .lecturer-block :global(.fact-tags) {
    margin-top: var(--space-2);
  }

  .lecturer-body {
    margin-top: var(--space-3);
    max-width: 60ch;
  }

  .lecturer-body :global(p) {
    font-size: 17px;
    line-height: 1.7;
    margin-top: var(--space-2);
  }

  .lecturer-body :global(p:first-child) {
    margin-top: 0;
  }

  .final-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
</style>
