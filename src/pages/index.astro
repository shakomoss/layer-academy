---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Layer Academy — არქიტექტურული პროგრამების კურსები ონლაინ"
  description="ისწავლეთ Archicad, AutoCAD, Revit, Rhino და 3ds Max ნულიდან — ჯგუფური კურსები და ინდივიდუალური მენტორინგი ონლაინ."
>
  <section class="container hero">
    <h1>ისწავლეთ არქიტექტურული პროგრამები ნულიდან</h1>
    <p>გვერდი მშენებლობის პროცესშია — სრული კონტენტი მომდევნო ეტაპზე დაემატება.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6);
  }
</style>
