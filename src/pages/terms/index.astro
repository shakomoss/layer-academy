---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBreadcrumbJsonLd } from '../../lib/structured-data';

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'წესები და პირობები', url: new URL('/terms/', Astro.site).toString() },
]);
---
<BaseLayout
  title="წესები და პირობები | Layer Academy"
  description="Layer Academy-ის კურსებზე და მენტორინგზე რეგისტრაციის, გადახდისა და გაუქმების წესები."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="container legal-page">
    <h1>წესები და პირობები</h1>

    <section>
      <h2>ზოგადი პირობები</h2>
      <p>
        ამ გვერდზე მითითებული წესები ვრცელდება Layer Academy-ის ჯგუფურ კურსებზე და ინდივიდუალურ
        მენტორინგზე რეგისტრაციაზე. საიტზე რეგისტრაციით თქვენ ეთანხმებით ამ წესებს.
      </p>
    </section>

    <section>
      <h2>რეგისტრაცია და გადახდა</h2>
      <p>
        რეგისტრაციის ფორმის შევსების შემდეგ დაგიკავშირდებით მითითებული ხერხით და გამოგიწერთ ინვოისს.
        გადახდა ხდება მხოლოდ ინვოისით, საბანკო გადარიცხვის საშუალებით — ონლაინ გადახდა არ არის
        ხელმისაწვდომი.
      </p>
    </section>

    <section>
      <h2>გაუქმება და დაბრუნების პოლიტიკა</h2>

      <h3>ჯგუფური კურსები</h3>
      <ul>
        <li>კურსის დაწყებამდე გაუქმების შემთხვევაში გადახდილი თანხა ბრუნდება სრულად.</li>
        <li>
          კურსის დაწყების შემდეგ გაუქმებისას დაბრუნებადი თანხის ოდენობა დამოკიდებულია იმაზე, თუ რამდენი
          მოცულობა აქვს უკვე ჩატარებული:
          <ul>
            <li>კურსის მასალის 25%-მდეა ჩატარებული — უბრუნდება 75%</li>
            <li>25%-დან 50%-მდეა ჩატარებული — უბრუნდება 50%</li>
            <li>50%-დან 75%-მდეა ჩატარებული — უბრუნდება 25%</li>
            <li>ჩატარებულია კურსის მასალის 75% ან მეტი — თანხა არ ბრუნდება</li>
          </ul>
        </li>
        <li>
          თუ კურსი გაუქმდება ან არსებითად გადაიდება Layer Academy-ის ინიციატივით, სტუდენტს უბრუნდება
          გადახდილი თანხა სრულად, დამოუკიდებლად იმისგან, რამდენი მასალა იყო უკვე ჩატარებული.
        </li>
      </ul>

      <h3>ინდივიდუალური მენტორინგი</h3>
      <ul>
        <li>მენტორინგის გაუქმება შესაძლებელია ნებისმიერ დროს, შემდეგი თვის დაწყებამდე.</li>
        <li>გაუქმება არ ვრცელდება უკვე ჩატარებულ სესიებზე მიმდინარე, გადახდილ თვეში.</li>
        <li>
          თუ გაუქმება ხდება მანამ, სანამ მიმდინარე გადახდილ თვეში არც ერთი სესია ჩატარებული არ არის,
          ამ თვის გადახდილი თანხა ბრუნდება სრულად.
        </li>
        <li>გაუქმების შემდეგ მომდევნო თვის ინვოისი აღარ გამოიწერება.</li>
      </ul>

      <h3>დაბრუნების მოთხოვნა</h3>
      <p>
        თანხის დაბრუნების ან რეგისტრაციის გაუქმების მოთხოვნისთვის <a href="/contact/">დაგვიკავშირდით</a>.
        დაბრუნება ხორციელდება იმავე საბანკო ანგარიშზე, საიდანაც მოხდა თავდაპირველი გადახდა.
      </p>
    </section>

    <section>
      <h2>პასუხისმგებლობა</h2>
      <p>
        Layer Academy ვალდებულია კურსი ან მენტორინგი ჩაატაროს გამოცხადებული ფორმატითა და განრიგით,
        შეძლებისდაგვარად. გარემოებების ცვლილების შემთხვევაში სტუდენტს ეცნობება წინასწარ.
      </p>
    </section>

    <section>
      <h2>ცვლილებები წესებში</h2>
      <p>
        ეს წესები შესაძლოა განახლდეს დროდადრო. განახლებული ვერსია ყოველთვის იქნება ხელმისაწვდომი ამ
        გვერდზე.
      </p>
    </section>

    <p class="legal-note">
      ეს დოკუმენტი არის ზოგადი შაბლონი და რეკომენდირებულია მისი გადამოწმება კვალიფიციურ იურისტთან,
      განსაკუთრებით გაუქმება-დაბრუნების პოლიტიკის ნაწილში.
    </p>
  </article>
</BaseLayout>

<style>
  .legal-page {
    padding-block: var(--space-5) var(--space-6);
    max-width: 65ch;
  }

  .legal-page h1 {
    margin-bottom: var(--space-3);
  }

  .legal-page section {
    margin-block: var(--space-4);
  }

  .legal-page h2 {
    margin-bottom: var(--space-1);
    font-size: 1.15rem;
  }

  .legal-page h3 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
    font-size: 1rem;
  }

  .legal-page ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legal-page ul ul {
    margin-top: 0.4rem;
  }

  .legal-note {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-divider);
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>
