---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBreadcrumbJsonLd } from '../../lib/structured-data';

const [settings] = await getCollection('settings');
const contactEmail = settings?.data.contactEmail || '';

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'მთავარი', url: new URL('/', Astro.site).toString() },
  { name: 'წესები და პირობები', url: new URL('/terms/', Astro.site).toString() },
]);
---
<BaseLayout
  title="წესები და პირობები | Layer Academy"
  description="Layer Academy-ის კურსებზე და მენტორინგზე რეგისტრაციის, გადახდისა და თანხის დაბრუნების წესები."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="container legal-page">
    <h1>წესები და პირობები</h1>
    <p class="legal-updated">ბოლო განახლება: 2026 წლის 22 ოქტომბერი</p>

    <section>
      <h2>ზოგადი დებულებები</h2>
      <p>
        ეს წესები ვრცელდება Layer Academy-ის ჯგუფურ კურსებსა და ინდივიდუალურ მენტორინგზე. საიტზე
        რეგისტრაციით და გადახდით ადასტურებთ, რომ გაეცანით და ეთანხმებით ამ წესებს.
      </p>
    </section>

    <section>
      <h2>მომსახურება</h2>
      <ul>
        <li>
          <strong>ჯგუფური კურსი</strong> — ლაივ ონლაინ ლექციები მცირე ჯგუფში, გამოცხადებული განრიგითა
          და სილაბუსით.
        </li>
        <li>
          <strong>ინდივიდუალური მენტორინგი</strong> — იგივე სილაბუსი, ოღონდ 1:1 ონლაინ შეხვედრებით
          ლექტორთან, თქვენთან შეთანხმებულ დროს.
        </li>
      </ul>
      <p>კურსის სრულად გავლის შემთხვევაში გაიცემა სერტიფიკატი.</p>
    </section>

    <section>
      <h2>რეგისტრაცია და გადახდა</h2>
      <ul>
        <li>
          რეგისტრაციის ფორმის გაგზავნა არის განაცხადი და არ გავალდებულებთ გადახდას. მის შემდეგ
          დაგიკავშირდებით, დავაზუსტებთ დეტალებს და გამოგიწერთ ინვოისს.
        </li>
        <li>
          გადახდა ხდება მხოლოდ ინვოისით, საბანკო გადარიცხვით. ონლაინ ბარათით გადახდა საიტზე არ ხდება.
        </li>
        <li>
          ადგილი ჯგუფში ან მენტორინგის დაწყების თარიღი თქვენთვის დაჯავშნილად ითვლება თანხის ჩარიცხვის შემდეგ.
        </li>
        <li>
          მოქმედებს ის ფასი, რომელიც მითითებული იყო საიტზე რეგისტრაციის მომენტში, მათ შორის ფასდაკლება,
          თუ რეგისტრაცია მისი მოქმედების ვადაში განხორციელდა.
        </li>
        <li>როგორც ჯგუფური კურსის, ისე მენტორინგის ფასი არის ერთჯერადი და მოიცავს სრულ კურსს.</li>
      </ul>
    </section>

    <section>
      <h2>სწავლის პროცესი</h2>
      <ul>
        <li>
          სწავლისთვის საჭიროა კომპიუტერი და სტაბილური ინტერნეტ კავშირი. ამ პირობების უზრუნველყოფა
          სტუდენტის პასუხისმგებლობაა.
        </li>
        <li>
          ჯგუფურ კურსზე გაცდენილი ლექცია ითვლება ჩატარებულად, თუმცა მისი ჩანაწერი ხელმისაწვდომი იქნება.
        </li>
        <li>მენტორინგის სესიის გადატანა შესაძლებელია ლექტორთან წინასწარი შეთანხმებით.</li>
      </ul>
    </section>

    <section>
      <h2>გაუქმება და თანხის დაბრუნება</h2>

      <h3>კურსის დაწყებამდე</h3>
      <p>თუ რეგისტრაციას გააუქმებთ კურსის ან მენტორინგის დაწყებამდე, გადახდილი თანხა ბრუნდება სრულად.</p>

      <h3>კურსის დაწყების შემდეგ</h3>
      <p>
        დაბრუნებადი თანხა დამოკიდებულია იმაზე, რა ნაწილი იყო უკვე ჩატარებული — ჯგუფური კურსისთვის
        ითვლება კურსის მასალა, მენტორინგისთვის — ჩატარებული სესიები:
      </p>
      <table class="refund-table">
        <thead>
          <tr><th>ჩატარებულია</th><th>ბრუნდება</th></tr>
        </thead>
        <tbody>
          <tr><td>25%-მდე</td><td>75%</td></tr>
          <tr><td>25%–50%</td><td>50%</td></tr>
          <tr><td>50%–75%</td><td>25%</td></tr>
          <tr><td>75% ან მეტი</td><td>არ ბრუნდება</td></tr>
        </tbody>
      </table>

      <h3>თუ კურსს ჩვენ ვაუქმებთ</h3>
      <p>
        თუ კურსი ან მენტორინგი გაუქმდება ან არსებითად გადაიდება Layer Academy-ის ინიციატივით, გადახდილი
        თანხა ბრუნდება სრულად, მიუხედავად იმისა, რა ნაწილი იყო უკვე ჩატარებული.
      </p>

      <h3>როგორ მოითხოვოთ</h3>
      <p>
        გაუქმებისა და თანხის დაბრუნების მოთხოვნისთვის დაგვიკავშირდით
        {contactEmail ? <> მისამართზე <a href={`mailto:${contactEmail}`}>{contactEmail}</a></> : <> <a href="/contact/">საკონტაქტო გვერდზე</a> მითითებული ხერხით</>}.
        თანხა ბრუნდება გონივრულ ვადაში, იმავე საბანკო ანგარიშზე, საიდანაც მოხდა გადახდა.
      </p>
    </section>

    <section>
      <h2>სასწავლო მასალები</h2>
      <p>
        ლექციების ჩანაწერები და სასწავლო მასალები განკუთვნილია მხოლოდ თქვენი პირადი სწავლისთვის. მათი
        გავრცელება, გაზიარება ან კომერციული გამოყენება Layer Academy-ის თანხმობის გარეშე დაუშვებელია.
      </p>
    </section>

    <section>
      <h2>პასუხისმგებლობა</h2>
      <p>
        Layer Academy ვალდებულია კურსი ან მენტორინგი ჩაატაროს გამოცხადებული ფორმატითა და სილაბუსით.
        განრიგის ცვლილების აუცილებლობის შემთხვევაში სტუდენტს წინასწარ ვაცნობებთ.
      </p>
    </section>

    <section>
      <h2>ცვლილებები წესებში</h2>
      <p>
        ეს წესები შესაძლოა განახლდეს. უკვე რეგისტრირებულ და გადახდილ სტუდენტებზე ვრცელდება ის ვერსია,
        რომელიც მოქმედებდა მათი რეგისტრაციის მომენტში.
      </p>
    </section>

    <p class="legal-note">
      ეს დოკუმენტი არ წარმოადგენს იურიდიულ კონსულტაციას. რეკომენდირებულია მისი გადამოწმება იურისტთან,
      რომელიც იცნობს საქართველოს მომხმარებელთა უფლებების დაცვის კანონმდებლობას.
    </p>
  </article>
</BaseLayout>

<style>
  .legal-page {
    padding-block: var(--space-5) var(--space-6);
    max-width: 65ch;
  }

  .legal-page h1 {
    margin-bottom: var(--space-1);
  }

  .legal-updated {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }

  .legal-page section {
    margin-block: var(--space-4);
  }

  .legal-page section > p + p {
    margin-top: var(--space-1);
  }

  .legal-page h2 {
    margin-bottom: var(--space-1);
    font-size: 1.15rem;
  }

  .legal-page h3 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
    font-size: 1rem;
  }

  .legal-page ul {
    margin: var(--space-1) 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .refund-table {
    margin-top: var(--space-2);
    border-collapse: collapse;
    width: 100%;
    max-width: 360px;
  }

  .refund-table th,
  .refund-table td {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-divider);
  }

  .refund-table th {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .legal-note {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-divider);
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>
