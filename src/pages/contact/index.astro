---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const [settings] = await getCollection('settings');
const data = settings?.data;

const links = [
  data?.contactPhone ? { href: `tel:${data.contactPhone.replace(/\s+/g, '')}`, label: data.contactPhone, kind: 'phone' } : null,
  data?.contactEmail ? { href: `mailto:${data.contactEmail}`, label: data.contactEmail, kind: 'email' } : null,
  data?.whatsappUrl ? { href: data.whatsappUrl, label: 'WhatsApp', kind: 'whatsapp' } : null,
  data?.messengerUrl ? { href: data.messengerUrl, label: 'Messenger', kind: 'messenger' } : null,
  data?.instagramUrl ? { href: data.instagramUrl, label: 'Instagram', kind: 'instagram' } : null,
  data?.facebookUrl ? { href: data.facebookUrl, label: 'Facebook', kind: 'facebook' } : null,
].filter(Boolean) as { href: string; label: string; kind: string }[];
---
<BaseLayout
  title="კონტაქტი | Layer Academy"
  description="დაგვიკავშირდეთ კურსებთან ან მენტორინგთან დაკავშირებული კითხვებისთვის."
>
  <section class="container contact-page">
    <h1>კონტაქტი</h1>
    <p>
      კითხვები გაქვთ კურსების ან მენტორინგის შესახებ? დაგვიკავშირდეთ რომელიმე ხერხით, ან
      <a href="/register/">დარეგისტრირდით</a> პირდაპირ — დანარჩენზე ჩვენ მოვიფიქრებთ.
    </p>

    {links.length > 0 ? (
      <ul class="contact-links">
        {links.map((link) => (
          <li>
            <a href={link.href} data-meta-contact={link.kind}>{link.label}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="contact-empty">საკონტაქტო ინფორმაცია მალე დაემატება.</p>
    )}
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-block: var(--space-5) var(--space-6);
    max-width: 60ch;
  }

  .contact-page h1 {
    margin-bottom: var(--space-2);
  }

  .contact-links {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border-top: 1px solid var(--color-divider);
  }

  .contact-links li {
    border-bottom: 1px solid var(--color-divider);
  }

  .contact-links a {
    display: flex;
    align-items: center;
    min-height: 56px;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .contact-empty {
    color: var(--color-muted);
    margin-top: var(--space-3);
  }
</style>
