# Absolute site URL, used for canonical links, sitemap, and JSON-LD. No trailing slash.
SITE_URL=https://layeracademy.ge

# Cloudflare Turnstile (anti-spam widget on the registration form).
# Get both from the Cloudflare dashboard -> Turnstile. Leave blank during
# local development — the form still works, just without bot verification.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (sends the registration notification + confirmation emails).
# Get from resend.com. Leave blank to run in local/dev mode, where
# submissions are logged instead of emailed.
RESEND_API_KEY=

# Meta (Facebook/Instagram) Pixel. Leave blank and no Pixel code renders at
# all — the site works fine before you have one. Get the Pixel ID and a
# Conversions API access token from Meta Events Manager -> Settings.
# The same PUBLIC_META_PIXEL_ID is used both by the browser Pixel and by the
# server-side Conversions API call — only one value to set.
PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Only set while testing in Meta Events Manager -> Test Events; remove for production.
META_TEST_EVENT_CODE=

# Optional: Google Analytics 4 measurement ID. Same consent rules as the Pixel.
PUBLIC_GA4_ID=
